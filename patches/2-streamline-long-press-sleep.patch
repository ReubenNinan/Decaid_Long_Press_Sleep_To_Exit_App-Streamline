+
+// --- exitDidNotLeave: a long-press exit that left the app on screen is undone
+
+test('an exit still on screen at the check undoes the screensaver suppression', () => {
+    const now = 100_000;
+    assert.equal(exitDidNotLeave({ exitedAt: now - EXIT_CHECK_MS, wentHidden: false, now }), true, 'iOS, or the exit failed');
+    assert.equal(exitDidNotLeave({ exitedAt: now - EXIT_CHECK_MS, wentHidden: true, now }), false, 'the page went hidden: it left');
+    assert.equal(exitDidNotLeave({ exitedAt: now - 60_000, wentHidden: false, now }), false, 'a late check means timers were paused in the background');
+    assert.equal(exitDidNotLeave({ exitedAt: 0, wentHidden: false, now }), false);
+});
