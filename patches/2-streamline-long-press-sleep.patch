@@ -23,6 +23,8 @@ import {
     shouldExitAfterSleep,
     deriveReturnWake,
     RETURN_WAKE_MIN_AWAY_MS,
+    exitDidNotLeave,
+    EXIT_CHECK_MS,
     isWakePending,
     WAKE_CONFIRM_GRACE_MS,
 } from '../src/modules/screensaver-policy.js';
@@ -314,3 +316,13 @@ test('focus churn right after the exit waits for the real return', () => {
     assert.equal(deriveReturnWake({ exitedAt: now - 200, wentHidden: true, machineState: 'sleeping', now }), 'wake', 'hidden then visible is a real return');
     assert.equal(deriveReturnWake({ exitedAt: now - RETURN_WAKE_MIN_AWAY_MS, wentHidden: false, machineState: 'sleeping', now }), 'wake');
