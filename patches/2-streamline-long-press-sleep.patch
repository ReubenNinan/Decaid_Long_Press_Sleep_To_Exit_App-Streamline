From 52a3079c49a1a08f7bd0f151a2b264a6c8fea00a Mon Sep 17 00:00:00 2001
From: Reuben Ninan <reubenninan@yahoo.com>
Date: Sun, 25 Oct 2026 22:27:29 +0000
Subject: [PATCH] Long-press Sleep puts the machine to sleep and exits the app

Restores the de1app behaviour: a tap on Sleep still sleeps or wakes the
machine; holding it for 0.8 s sleeps the machine and, once the gateway
accepts the request, calls window.decentApp.exitApp() so the tablet can
be used normally. A long press on "Awake" only wakes, and hosts without
exitApp() just sleep.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WabCzdX53ns7vgwepG6uCf
---
 src/modules/screensaver-policy.js | 15 +++++++++++++++
 src/modules/ui.js                 | 17 ++++++++++++++---
 test/screensaver-policy.test.mjs  | 14 ++++++++++++++
 3 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/src/modules/screensaver-policy.js b/src/modules/screensaver-policy.js
index 93d75f1..c1505e9 100644
--- a/src/modules/screensaver-policy.js
+++ b/src/modules/screensaver-policy.js
@@ -138,6 +138,21 @@ export function deriveSleepButtonAction({ machineState, screensaverActive = fals
     return { command: 'sleeping', hideScreensaver: false };
 }
 
+/** How long Sleep must be held to sleep the machine and leave the app. */
+export const SLEEP_EXIT_HOLD_MS = 800;
+
+/**
+ * Should a long-pressed Sleep leave the app once its command has been accepted?
+ *
+ * The de1app's long-press sleep: put the machine to sleep and hand the tablet
+ * back. Only when the press actually slept the machine (a long press on "Awake"
+ * is just a wake), and only on hosts that offer `decentApp.exitApp()`; older
+ * Decaid builds simply sleep.
+ */
+export function shouldExitAfterSleep(action, decentApp) {
+    return action?.command === 'sleeping' && typeof decentApp?.exitApp === 'function';
+}
+
 /**
  * What the panel brightness should do on a machine state TRANSITION.
  *
